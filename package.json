{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:entry": "node --disable-warning=ExperimentalWarning scripts/check-server-entry.mjs",
    "test:rules": "tsx --test tests/firestore.rules.mts",
    "test:browser": "node scripts/check-reports-build.mjs && node scripts/check-app-flows.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^3.3.0",
    "@hono/node-server": "^2.1.11",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^17.2.3",
    "firebase": "^13.3.0",
    "hono": "^4.13.19",
    "motion": "^12.23.24",
    "radix-ui": "^1.8.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "playwright-core": "1.62.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
